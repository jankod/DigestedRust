# --- Manifest exports (MS_<SECTION>__<KEY>=value) ---
# Human-readable database name shown in manifest metadata.
MS_DB__NAME="UniProt Swiss-Prot Trypsin"
# Short description of this specific build/profile.
MS_DB__DESCRIPTION="Swiss-Prot build for a local workflow"
# Builder/tool version written to manifest for traceability.
MS_DB__TOOL_VERSION="DigestedProtein DB cli 0.0.1"

# --- Pipeline step selection (optional) ---
# Choose which orchestrator steps run by ID (comma-separated).
# If unset, all steps run (1..8).
# IDs follow the order from python_orchestrator/main.py -> STEPS list.
# Examples:
# PIPELINE_STEP_IDS=7                    # only validation
# PIPELINE_STEP_IDS=8                    # only packaging
# PIPELINE_STEP_IDS=5,6,7,8              # continue from step5 onward
# PIPELINE_STEP_IDS=1,2,3,4,5,6,7,8      # all steps
PIPELINE_STEP_IDS=7
# If true, rerun selected steps even when build_state marks them as completed.
PIPELINE_RERUN_COMPLETED=true

# --- Source metadata ---
# Input UniProt XML.GZ file used as the primary source for Step1.
PATH_INPUT_XML_GZ_FILE=/path/to/uniprot_sprot_release_2026_01_28-Jan-2026.xml.gz
# Source database name stored in manifest [source].
MS_SOURCE__DATABASE_NAME=UniProt
# Source release/version label stored in manifest [source].
MS_SOURCE__DATABASE_RELEASE=2026_01_28

# --- Step outputs (relative to PATH_BUILD_DIR) ---
# Step1 output parquet with parsed proteins.
PATH_PROTEINS_PARQUET_FILE=intermediate_data/proteins.parquet
# Optional taxonomy whitelist (CSV TaxIDs). Empty = no taxonomy filter.
MS_SOURCE__FILTER_TAX_IDS=
# Optional division whitelist (CSV division IDs).
MS_SOURCE__FILTER_DIV_IDS=4,5
# Step2 output parquet with unsorted peptide records.
PATH_PEPTIDES_UNSORTED_PARQUET_FILE=intermediate_data/peptides_unsorted.parquet
# Step2 output parquet mapping accession strings to numeric accession_id.
PATH_ACCESSION_DICT_PARQUET_FILE=intermediate_data/accession_dict.parquet
# Step3 output parquet sorted by mass, peptide.
PATH_PEPTIDES_SORTED_PARQUET_FILE=intermediate_data/peptides_sorted.parquet
# Final RocksDB directory (base path for DB artifacts).
PATH_ROCKSDB_OUTPUT_DIR=final_db/rocksdb

# --- Digestion ---
# Allowed number of missed cleavages for digestion.
MS_DIGESTION__MISSED_CLEAVAGES=1
# Minimum peptide length kept after digestion.
MS_DIGESTION__MIN_LENGTH=6
# Maximum peptide length kept after digestion.
MS_DIGESTION__MAX_LENGTH=30

# --- System ---
# Max in-memory chunk size (GB) before step2 flushes rows to peptides parquet.
# Larger value = fewer flushes and potentially faster write, but more RAM usage.
SYSTEM_CHUNK_SIZE_GB=20

# --- Step3 DuckDB sort ---
# CRITICAL: keep this large enough. Too small value can create too many parquet row groups,
# which caused downstream RocksDB reader issues on very large datasets.
STEP3_ROW_GROUP_SIZE=5000000
# DuckDB executable used in Step3 sorting.
PATH_DUCKDB_BIN=duckdb
# Temporary directory for DuckDB spill/intermediate files.
PATH_DUCKDB_TEMP_DIR=intermediate_data/tmp_duckdb
# Optional: DUCKDB_MEMORY_LIMIT=90GB

# --- Step4 RocksDB population ---
# Number of parquet rows read per batch while populating RocksDB.
STEP4_READ_BATCH_SIZE=1000000
# Target maximum SST file size (GB) for RocksDB ingestion output.
STEP4_MAX_SST_FILE_SIZE_GB=2

# --- Step5 taxonomy.bin ---
# Output taxonomy.bin is written into PATH_ROCKSDB_OUTPUT_DIR by default.
# NCBI taxonomy nodes.dmp input file.
PATH_TAXONOMY_NODES_DMP_FILE=/path/to/taxdump/nodes.dmp
# NCBI taxonomy names.dmp input file.
PATH_TAXONOMY_NAMES_DMP_FILE=/path/to/taxdump/names.dmp
# Optional:
# NCBI merged.dmp (taxonomy ID remaps from old -> current IDs).
# PATH_TAXONOMY_MERGED_DMP_FILE=/path/to/taxdump/merged.dmp

# --- Step6 accession dictionary binary ---
# Output acc_dict.bin is written into PATH_ROCKSDB_OUTPUT_DIR by default.
# Parquet read batch size when building acc_dict.bin.
STEP6_READ_BATCH_SIZE=262144
# Optional override:
# Explicit output path for generated acc_dict.bin (relative to PATH_BUILD_DIR unless absolute).
# PATH_ACCESSION_DICT_BIN_FILE=final_db/rocksdb/acc_dict.bin

# --- Step7 database validation ---
# Validation mode controls sample sizes and thresholds:
# quick    = fastest smoke check
# standard = balanced default (recommended)
# strict   = biggest samples + tightest thresholds
STEP7_MODE=standard

# Require taxonomy.bin to exist and be validated.
# Code default: false
STEP7_REQUIRE_TAXONOMY=true

# Cross-check sampled rows from peptides_sorted.parquet against RocksDB.
# Code default: true
STEP7_ENABLE_PARQUET_CROSSCHECK=true

# Optional explicit paths (default paths are auto-resolved):
# Explicit acc_dict.bin path used only by Step7 validator.
# STEP7_PATH_ACCESSION_DICT_BIN_FILE=final_db/rocksdb/acc_dict.bin
# Explicit taxonomy.bin path used only by Step7 validator.
# STEP7_PATH_TAXONOMY_BIN_FILE=final_db/rocksdb/taxonomy.bin
# Explicit peptides_sorted.parquet path used only by Step7 validator.
# STEP7_PATH_PEPTIDES_SORTED_PARQUET_FILE=intermediate_data/peptides_sorted.parquet

# Sampling / validation limits:
# STEP7_DB_SCAN_LIMIT_KEYS = max number of mass keys scanned from DB.
#   defaults by mode: quick=50000, standard=scan all, strict=scan all
# STEP7_DB_HEAD_SAMPLE_KEYS = number of first mass keys saved as head sample.
#   defaults: quick=100, standard=500, strict=2000
# STEP7_DB_TAIL_SAMPLE_KEYS = number of last mass keys saved as tail sample.
#   defaults: quick=100, standard=500, strict=2000
# STEP7_MAX_RECORD_VALIDATIONS = max peptide records for deep per-record checks.
#   defaults: quick=50000, standard=500000, strict=2000000
# STEP7_PARQUET_SAMPLE_ROWS = max sampled rows from peptides_sorted.parquet.
#   defaults: quick=2000, standard=20000, strict=100000
# STEP7_PARQUET_SAMPLE_EVERY = sample every N-th parquet row.
#   defaults: quick=1000, standard=250, strict=50
# Uncomment only if you want to override mode defaults:
# Cap for scanned mass keys in RocksDB iterator.
# STEP7_DB_SCAN_LIMIT_KEYS=50000
# Number of first keys stored as head sample in result JSON.
# STEP7_DB_HEAD_SAMPLE_KEYS=500
# Number of last keys stored as tail sample in result JSON.
# STEP7_DB_TAIL_SAMPLE_KEYS=500
# Upper bound of per-record deep validations (accession/taxonomy checks).
# STEP7_MAX_RECORD_VALIDATIONS=500000
# Maximum parquet rows sampled for DB cross-check.
# STEP7_PARQUET_SAMPLE_ROWS=20000
# Sampling stride (take every N-th parquet row).
# STEP7_PARQUET_SAMPLE_EVERY=250

# STEP7_PARQUET_BATCH_SIZE = parquet reader batch size.
# Code default: 131072
STEP7_PARQUET_BATCH_SIZE=131072

# Quality thresholds:
# STEP7_MAX_MISSING_ACCESSION_RATIO = missing accession_ids / accession checks.
#   defaults: quick=0.01, standard=0.001, strict=0.0001
# STEP7_MAX_UNKNOWN_TAXONOMY_RATIO = unknown taxonomy IDs / taxonomy checks.
#   defaults: quick=0.20, standard=0.10, strict=0.05
# STEP7_MAX_PARQUET_MISSING_RATIO = sampled parquet rows not found in RocksDB.
#   defaults: quick=0.01, standard=0.001, strict=0.0
# Uncomment only if you want custom thresholds:
# Allowed ratio of missing accession IDs in validated rows.
# STEP7_MAX_MISSING_ACCESSION_RATIO=0.001
# Allowed ratio of taxonomy IDs not found in taxonomy.bin.
# STEP7_MAX_UNKNOWN_TAXONOMY_RATIO=0.10
# Allowed ratio of sampled parquet rows missing in RocksDB.
# STEP7_MAX_PARQUET_MISSING_RATIO=0.001

# Preset notes:
# quick:    fast smoke-check on subset of data
# standard: balanced default for regular builds
# strict:   larger samples and tighter thresholds

# --- Step8 database packaging (optional) ---
# step8_package_db is part of orchestrator STEPS and runs after manifest generation.
# Archive format: auto, tar.zst, zip, or comma-separated explicit formats.
STEP8_FORMATS=auto
# Optional:
# Output directory for Step8 archives (relative to PATH_BUILD_DIR unless absolute).
# STEP8_OUTPUT_DIR=release
# Root folder name inside archive and base archive filename.
# STEP8_PACKAGE_NAME=swisprot_trypsin_home_db
# DB schema version written to package manifest for runtime compatibility checks.
STEP8_DB_SCHEMA_VERSION=1
# Minimum massq version required by packaged database.
STEP8_MIN_MASSQ_VERSION=0.1.0
# Overwrite existing package archives when present.
STEP8_FORCE=true
# Optional debug flags:
# Keep temporary staging folder used during archive creation.
# STEP8_KEEP_STAGING=false
# Build staged package content but skip writing final archive files.
# STEP8_DRY_RUN=false
